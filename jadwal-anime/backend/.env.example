# Contoh .env untuk backend (schedule.php + todoist.php)
# Copy ke file bernama `.env` di folder yang sama dengan file PHP-nya, lalu isi nilai aslinya.
# PENTING: .env JANGAN di-commit ke git (isi kredensial DB + token).

# Di server (cPanel), DB_HOST pakai "localhost".
# IP server cuma buat akses remote dari mesin lokal (via Remote MySQL).
DB_HOST=localhost

DB_USER=
DB_PASS=
DB_DATABASE=
DB_PREFIX=
TODOIST_TOKEN=
